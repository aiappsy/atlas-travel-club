rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the resource owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check admin status
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper to check active membership
    function isActiveMember() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.membershipStatus == 'active';
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Membership Tiers (Publicly readable)
    match /membership_tiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Wholesale Hotels & Cached Inventory
    match /hotels/{hotelId} {
      // Public can see preview, active members get full wholesale price details
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member Bookings
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Local Perks, Dining, Entertainment Vouchers
    match /perks/{perkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Redeemed Member Vouchers
    match /redeemed_vouchers/{voucherId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }
  }
}
